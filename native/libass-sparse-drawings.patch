+static void expand_sparse_drawing(RenderContext *state, double device_x, double device_y)
+{
+    TextInfo *text = &state->text_info;
+    if (text->length != 1)
+        return;
+    GlyphInfo *head = text->glyphs;
+    if (!head->drawing_text.str || head->next || !head->outline ||
+        !head->outline->sparse_count || head->border_style != 1 ||
+        head->border_x || head->border_y || head->shadow_x || head->shadow_y ||
+        head->be || head->blur || head->frx || head->fry || head->frz ||
+        head->fax || head->fay || head->effect_type != EF_NONE ||
+        head->transform.scale.x < .25 || head->transform.scale.y < .25)
+        return;
+    OutlineHashValue *source = head->outline;
+    double m[3][3];
+    GlyphInfo positioned = *head;
+    int left = state->renderer->settings.left_margin;
+    device_x = (device_x - left) * state->renderer->par_scale_x + left;
+    positioned.pos.x = double_to_d6(device_x + d6_to_double(head->pos.x) * state->renderer->par_scale_x);
+    positioned.pos.y = double_to_d6(device_y) + head->pos.y;
+    calc_transform_matrix(state, &positioned, m);
+    const ASS_Transform *tr = &head->transform;
+    double sx = m[0][0] * tr->scale.x / m[2][2] / 64;
+    double sy = m[1][1] * tr->scale.y / m[2][2] / 64;
+    double tx = (m[0][0] * tr->offset.x + m[0][2]) / m[2][2] / 64;
+    double ty = (m[1][1] * tr->offset.y + m[1][2]) / m[2][2] / 64;
+    GlyphInfo first = {0};
+    GlyphInfo **tail = &first.next;
+    bool any = false;
+    for (int i = 0; i < source->sparse_count; i++) {
+        OutlineHashKey key = { .type = OUTLINE_COMPONENT };
+        key.u.component.outline = source;
+        key.u.component.index = i;
+        OutlineHashValue *part = ass_cache_get(state->renderer->cache.outline_cache,
+                                               &key, state->renderer);
+        if (part && part->valid) {
+            const ASS_Rect *b = &part->tight_cbox;
+            double x0 = sx * b->x_min + tx, x1 = sx * b->x_max + tx;
+            double y0 = sy * b->y_min + ty, y1 = sy * b->y_max + ty;
+            if (FFMAX(x0, x1) < -2 || FFMAX(y0, y1) < -2 ||
+                FFMIN(x0, x1) > state->renderer->settings.frame_width + 2 ||
+                FFMIN(y0, y1) > state->renderer->settings.frame_height + 2)
+                continue;
+        }
+        GlyphInfo *copy = !part || !part->valid ? NULL :
+            any ? malloc(sizeof(*copy)) : &first;
+        if (!copy) {
+            GlyphInfo *item = first.next;
+            while (item) {
+                GlyphInfo *next = item->next;
+                free(item);
+                item = next;
+            }
+            return;
+        }
+        *copy = *head;
+        copy->outline = part;
+        copy->starts_new_run = true;
+        copy->next = NULL;
+        if (any)
+            *tail = copy;
+        any = true;
+        tail = &copy->next;
+    }
+    if (any)
+        *head = first;
+    else
+        head->skip = true;
+}
