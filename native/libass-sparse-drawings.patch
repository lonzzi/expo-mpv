+// Keep disconnected drawing contours in small raster surfaces. The geometry,
+// winding of overlapping contours, layout and original transform stay intact.
+typedef struct {
+    size_t point, points, segment, segments;
+    ASS_Rect box;
+    int parent;
+} SparseContour;
+
+static int sparse_root(SparseContour *c, int i)
+{
+    while (c[i].parent != i) {
+        c[i].parent = c[c[i].parent].parent;
+        i = c[i].parent;
+    }
+    return i;
+}
+
+static void sparse_outline_parts(OutlineHashValue *v)
+{
+    const ASS_Outline *ol = &v->outline[0];
+    int count = 0;
+    for (size_t i = 0; i < ol->n_segments; i++)
+        count += !!(ol->segments[i] & OUTLINE_CONTOUR_END);
+    if (count < 2 || count > 1024)
+        return;
+    SparseContour *c = calloc(count, sizeof(*c));
+    if (!c)
+        return;
+    size_t point = 0, first_point = 0, first_seg = 0;
+    int n = 0;
+    for (size_t i = 0; i < ol->n_segments; i++) {
+        point += ol->segments[i] & OUTLINE_COUNT_MASK;
+        if (!(ol->segments[i] & OUTLINE_CONTOUR_END))
+            continue;
+        c[n].point = first_point;
+        c[n].points = point - first_point;
+        c[n].segment = first_seg;
+        c[n].segments = i + 1 - first_seg;
+        c[n].parent = n;
+        rectangle_reset(&c[n].box);
+        for (size_t j = first_point; j < point; j++) {
+            ASS_Vector p = ol->points[j];
+            rectangle_update(&c[n].box, p.x, p.y, p.x, p.y);
+        }
+        first_point = point;
+        first_seg = i + 1;
+        n++;
+    }
+    if (point != ol->n_points || first_seg != ol->n_segments) {
+        free(c);
+        return;
+    }
+    // Eight script pixels protect antialiased boundaries at scales >= 1/4.
+    const int64_t pad = 8 * 64;
+    for (int i = 0; i < count; i++)
+        for (int j = 0; j < i; j++) {
+            ASS_Rect a = c[i].box, b = c[j].box;
+            if ((int64_t)a.x_min <= b.x_max + pad &&
+                (int64_t)b.x_min <= a.x_max + pad &&
+                (int64_t)a.y_min <= b.y_max + pad &&
+                (int64_t)b.y_min <= a.y_max + pad)
+                c[sparse_root(c, i)].parent = sparse_root(c, j);
+        }
+    int groups = 0;
+    double area = 0;
+    for (int i = 0; i < count; i++) {
+        if (sparse_root(c, i) != i)
+            continue;
+        ASS_Rect box;
+        rectangle_reset(&box);
+        for (int j = 0; j < count; j++)
+            if (sparse_root(c, j) == i)
+                rectangle_update(&box, c[j].box.x_min, c[j].box.y_min,
+                                 c[j].box.x_max, c[j].box.y_max);
+        area += (double)(box.x_max - box.x_min + 64) *
+                (box.y_max - box.y_min + 64);
+        groups++;
+    }
+    double original = (double)(v->cbox.x_max - v->cbox.x_min + 64) *
+                      (v->cbox.y_max - v->cbox.y_min + 64);
+    if (groups < 2 || original < 65536.0 * 4096 || area > original * .5) {
+        free(c);
+        return;
+    }
+    ASS_Outline *parts = calloc(groups, sizeof(*parts));
+    if (!parts) {
+        free(c);
+        return;
+    }
+    int group = 0;
+    for (int i = 0; i < count; i++) {
+        if (sparse_root(c, i) != i)
+            continue;
+        size_t np = 0, ns = 0;
+        for (int j = 0; j < count; j++)
+            if (sparse_root(c, j) == i) {
+                np += c[j].points;
+                ns += c[j].segments;
+            }
+        if (!ass_outline_alloc(&parts[group], np, ns)) {
+            for (int j = 0; j < groups; j++)
+                ass_outline_free(&parts[j]);
+            free(parts);
+            free(c);
+            return;
+        }
+        ASS_Outline *p = &parts[group++];
+        for (int j = 0; j < count; j++)
+            if (sparse_root(c, j) == i) {
+                memcpy(p->points + p->n_points, ol->points + c[j].point,
+                       c[j].points * sizeof(ASS_Vector));
+                memcpy(p->segments + p->n_segments, ol->segments + c[j].segment,
+                       c[j].segments);
+                p->n_points += c[j].points;
+                p->n_segments += c[j].segments;
+            }
+    }
+    v->sparse_count = groups;
+    v->sparse_parts = parts;
+    free(c);
+}
